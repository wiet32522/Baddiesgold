local function findCashItems()
    local cashFolder = workspace:FindFirstChild("Cash")
    if not cashFolder then
        cashSection:addButton("Cash folder not found", function() end)
        return
    end
    
    local items = {}
    for _, item in pairs(cashFolder:GetChildren()) do
        local name = item.Name
        name = name:gsub("Comprar", ""):gsub("Cash", ""):gsub("^%s*(.-)%s*$", "%1")
        
        if item:IsA("BasePart") or (item:IsA("Model") and item:FindFirstChildWhichIsA("BasePart")) then
            table.insert(items, {name = name, instance = item})
        end
    end
    
    table.sort(items, function(a, b) return a.name < b.name end)
    
    for _, item in ipairs(items) do
        cashSection:addButton(item.name, function()
            local targetPart = item.instance
            if targetPart:IsA("Model") then
                targetPart = targetPart:FindFirstChildWhichIsA("BasePart") or targetPart.PrimaryPart
            end
            
            if targetPart then
                teleportTo(targetPart.Position)
                wait(0.5)
                clickButton()
            else
                venyx:Notify("Error", "Could not find a valid part to teleport to")
            end
        end)
    end
end

findCashItems()

