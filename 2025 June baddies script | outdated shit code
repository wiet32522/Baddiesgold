local function updateTargetInfoGui(target)
    if not targetInfoGui then
        targetInfoGui = createTargetInfoGui()
    end
    
    if not target or not target.Character or not target.Character:FindFirstChild("Humanoid") then
        targetInfoGui.Frame.NameLabel.Text = "Name: None"
        targetInfoGui.Frame.HealthLabel.Text = "Health: 0/0"
        targetInfoGui.Frame.DistanceLabel.Text = "Distance: 0 studs"
        return
    end
    
    local health = target.Character.Humanoid.Health
    local maxHealth = target.Character.Humanoid.MaxHealth
    local distance = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - target.Character.HumanoidRootPart.Position).Magnitude
    
    targetInfoGui.Frame.NameLabel.Text = "Name: " .. target.Name
        targetInfoGui.Frame.HealthLabel.Text = "Health: " .. math.floor(health) .. "/" .. math.floor(maxHealth)
    targetInfoGui.Frame.DistanceLabel.Text = "Distance: " .. math.floor(distance) .. " studs"
    
    local healthPercent = health / maxHealth
    local healthColor
    if healthPercent > 0.7 then
        healthColor = Color3.fromRGB(0, 255, 0)
    elseif healthPercent > 0.3 then
        healthColor = Color3.fromRGB(255, 255, 0)
    else
        healthColor = Color3.fromRGB(255, 0, 0)
    end
    
    targetInfoGui.Frame.HealthLabel.TextColor3 = healthColor
end

