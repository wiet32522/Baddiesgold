local function isValidTarget(player)
    if player == game.Players.LocalPlayer then return false end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return false end
    if not player.Character:FindFirstChild("Humanoid") or player.Character.Humanoid.Health <= 0 then return false end
    
    local distance = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
    if distance > config.maxDistance then return false end
    
    if config.ignoreTeam and player.Team == game.Players.LocalPlayer.Team then return false end
    
    if not config.wallBangEnabled then
        local ray = Ray.new(
            game.Players.LocalPlayer.Character.Head.Position,
            (player.Character.Head.Position - game.Players.LocalPlayer.Character.Head.Position).Unit * config.maxDistance
        )
        local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, {game.Players.LocalPlayer.Character, player.Character})
        if hit then return false end
    end
    
    return true
end

-- Get target based on current settings
local function getTarget()
    local currentTime = tick()
    if currentTarget and isValidTarget(currentTarget) and currentTime - lastTargetUpdate < targetUpdateInterval then
        return currentTarget
    end
    
    lastTargetUpdate = currentTime
    
    if config.targetMode == "Specific Player" and config.specificPlayer then
        local player = game.Players:FindFirstChild(config.specificPlayer)
        if player and isValidTarget(player) then
            currentTarget = player
            return player
        end
        currentTarget = nil
        return nil
    end
    
    local validTargets = {}
    
    for _, player in pairs(game.Players:GetPlayers()) do
        if isValidTarget(player) then
            table.insert(validTargets, player)
        end
    end
    
    if #validTargets == 0 then
        currentTarget = nil
        return nil
    end
    
    if config.targetMode == "Random" then
        currentTarget = validTargets[math.random(1, #validTargets)]
        return currentTarget
    elseif config.targetMode == "Lowest Health" then
        local lowestHealth = math.huge
        local lowestHealthPlayer = nil
        
        for _, player in pairs(validTargets) do
            local health = player.Character.Humanoid.Health
            if health < lowestHealth then
                lowestHealth = health
                lowestHealthPlayer = player
            end
        end
        
        currentTarget = lowestHealthPlayer
        return lowestHealthPlayer
    else 
        local closestDistance = math.huge
        local closestPlayer = nil
        
        for _, player in pairs(validTargets) do
            local distance = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
        
        currentTarget = closestPlayer
        return closestPlayer
    end
end

local function shouldHit()
    return math.random(1, 100) <= config.hitChance
end

local function makeWallBang(bullet)
    bullet.CanCollide = false
    bullet.Massless = true
    
    pcall(function()
        bullet.CanTouch = false
        bullet.CanQuery = false
    end)
    
    if bullet:FindFirstChild("TouchInterest") then
        bullet:FindFirstChild("TouchInterest"):Destroy()
    end
end

local function redirectBullet(bullet, targetPosition, originalPosition)
    if not bullet or not targetPosition then return end
    
    if config.randomization > 0 then
        local randomOffset = Vector3.new(
            (math.random() - 0.5) * config.randomization / 50,
            (math.random() - 0.5) * config.randomization / 50,
            (math.random() - 0.5) * config.randomization / 50
        )
        targetPosition = targetPosition + randomOffset
    end
    
    if bullet:FindFirstChildOfClass("BodyVelocity") then
        bullet:FindFirstChildOfClass("BodyVelocity"):Destroy()
    end
    
    local direction = (targetPosition - bullet.Position).Unit
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.P = math.huge
    bodyVelocity.Velocity = direction * config.bulletSpeed
    bodyVelocity.Parent = bullet
    
    bullet.CFrame = CFrame.lookAt(bullet.Position, targetPosition)
    
    if config.drawTracers and originalPosition then
        local tracer = Instance.new("Part")
        tracer.Anchored = true
        tracer.CanCollide = false
        tracer.Material = Enum.Material.Neon
        tracer.Color = config.tracerColor
        tracer.Transparency = 0.5
        
        local distance = (targetPosition - originalPosition).Magnitude
        tracer.Size = Vector3.new(0.1, 0.1, distance)
        tracer.CFrame = CFrame.new(originalPosition + (targetPosition - originalPosition) / 2, targetPosition)
        tracer.Parent = workspace.CurrentCamera
        
        table.insert(tracers, tracer)
        
        game:GetService("Debris"):AddItem(tracer, 1)
    end
end

