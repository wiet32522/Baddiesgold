    slider.ValueLabel.TextSize = Config.FontSize
    slider.ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    slider.ValueLabel.Parent = slider.Frame
    
    slider.SliderBar = Instance.new("Frame")
    slider.SliderBar.Name = "SliderBar"
    slider.SliderBar.Size = UDim2.new(1, -40, 0, 4)
    slider.SliderBar.Position = UDim2.new(0, 20, 0, Config.ButtonSize)
    slider.SliderBar.BackgroundColor3 = self.Theme.Secondary
    slider.SliderBar.BorderSizePixel = 0
    slider.SliderBar.Parent = slider.Frame
    
    local barCorner = Utility.CreateCorner(2)
    barCorner.Parent = slider.SliderBar
    
    slider.SliderFill = Instance.new("Frame")
    slider.SliderFill.Name = "SliderFill"
    slider.SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    slider.SliderFill.Position = UDim2.new(0, 0, 0, 0)
    slider.SliderFill.BackgroundColor3 = self.Theme.Accent
    slider.SliderFill.BorderSizePixel = 0
    slider.SliderFill.Parent = slider.SliderBar
    
    local fillCorner = Utility.CreateCorner(2)
    fillCorner.Parent = slider.SliderFill
    
    slider.SliderButton = Instance.new("TextButton")
    slider.SliderButton.Name = "SliderButton"
    slider.SliderButton.Size = UDim2.new(0, 16, 0, 16)
    slider.SliderButton.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
    slider.SliderButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    slider.SliderButton.BorderSizePixel = 0
    slider.SliderButton.Text = ""
    slider.SliderButton.Parent = slider.SliderBar
    
    local buttonCorner = Utility.CreateCorner(8)
    buttonCorner.Parent = slider.SliderButton
    
    local function updateSlider(inputPosition)
        local barPos = slider.SliderBar.AbsolutePosition
        local barSize = slider.SliderBar.AbsoluteSize
        
        local relativeX = Utility.Clamp((inputPosition.X - barPos.X) / barSize.X, 0, 1)
        local value = min + (relativeX * (max - min))
        
        slider.Value = value
        slider.SliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
        slider.SliderButton.Position = UDim2.new(relativeX, -8, 0.5, -8)
        slider.ValueLabel.Text = string.format("%.1f", value)
        
        callback(value)
    end
    
    local dragging = false
    
    local function onSliderBegan(input, gameProcessed)
        if gameProcessed then return end
        dragging = true
        updateSlider(input.Position)
    end
    
    local function onSliderChanged(input)
        if dragging then
            updateSlider(input.Position)
        end
    end
    
    local function onSliderEnded()
        dragging = false
    end
    
    slider.SliderButton.MouseButton1Down:Connect(onSliderBegan)
    slider.SliderBar.MouseButton1Down:Connect(onSliderBegan)
    
    self.Connections.SliderMove = UserInputService.InputChanged:Connect(onSliderChanged)
    self.Connections.SliderEnd = UserInputService.InputEnded:Connect(onSliderEnded)
    
    -- Mobile Touch Support
    if not DeviceDetection.IsPC then
        slider.SliderButton.TouchTap:Connect(function(input, gameProcessed)
            if not gameProcessed then
                updateSlider(input.Position)
            end
        end)
        
        slider.SliderBar.TouchTap:Connect(function(input, gameProcessed)
            if not gameProcessed then
                updateSlider(input.Position)
            end
        end)
    end
    
    table.insert(section.Elements, slider)
    
    -- Update section size
    self:UpdateSectionSize(section)
    
    return slider
end

