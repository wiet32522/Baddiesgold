    corner.Parent = notification
    
    notification.Position = UDim2.new(1, 0, 0, 0)
    Utility.Tween(notification, TweenInfo.new(0.3), {Position = UDim2.new(0, -320, 0, 0)}):Play()
    
    task.spawn(function()
        task.wait(duration)
        Utility.Tween(notification, TweenInfo.new(0.3), {Position = UDim2.new(1, 0, 0, 0)}):Play()
        task.wait(0.3)
        screenGui:Destroy()
    end)
end

