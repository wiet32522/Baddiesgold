function Window:SetupInteractions()
    -- Close Button
    self.CloseButton.MouseButton1Click:Connect(function()
        self:Destroy()
    end)
    
    -- Minimize Button
    if self.MinimizeButton then
        self.MinimizeButton.MouseButton1Click:Connect(function()
            self:ToggleMinimize()
        end)
    end
    
    if self.Draggable then
        self:MakeDraggable()
    end
    
    -- Hover Effects (PC Only)
    if DeviceDetection.IsPC then
        self:SetupHoverEffects()
    end
end

function Window:MakeDraggable()
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    local function updateInput(input)
        if dragging then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
    
    if DeviceDetection.IsPC then
        -- Mouse dragging
        self.Connections.DragStart = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            
            if input.UserInputType == Enum.UserInputType.MouseButton1 and self.TitleBar:IsDescendantOf(input.Target) then
                dragging = true
                dragStart = input.Position
                startPos = self.MainFrame.Position
            end
        end)
        
        self.Connections.DragMove = UserInputService.InputChanged:Connect(updateInput)
        
        self.Connections.DragEnd = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
    else
        -- Touch dragging
        self.Connections.TouchDrag = UserInputService.TouchBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            
            local touchPos = input.Position
            local guiObjects = GuiService:GetGuiObjectsAtPosition(touchPos.X, touchPos.Y)
            
            for _, obj in ipairs(guiObjects) do
                if obj == self.TitleBar then
                    dragging = true
                    dragStart = touchPos
                    startPos = self.MainFrame.Position
                    break
                end
            end
        end)
        
        self.Connections.TouchMove = UserInputService.TouchMoved:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            updateInput(input)
        end)
        
        self.Connections.TouchEnd = UserInputService.TouchEnded:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            dragging = false
        end)
    end
end

function Window:SetupHoverEffects()
    -- Close Button Hover
    self.CloseButton.MouseEnter:Connect(function()
        Utility.Tween(self.CloseButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}):Play()
    end)
    
    self.CloseButton.MouseLeave:Connect(function()
        Utility.Tween(self.CloseButton, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Error}):Play()
    end)
    
    -- Minimize Button Hover
    if self.MinimizeButton then
        self.MinimizeButton.MouseEnter:Connect(function()
            Utility.Tween(self.MinimizeButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 160, 0)}):Play()
        end)
        
        self.MinimizeButton.MouseLeave:Connect(function()
            Utility.Tween(self.MinimizeButton, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Warning}):Play()
        end)
    end
end

function Window:Tab(config)
    config = config or {}
    local name = config.Title or "New Tab"
    local icon = config.Icon or "📄"
    
    local tab = {
        Name = name,
        Icon = icon,
        Sections = {},
        Frame = nil,
        Button = nil,
        Layout = nil
    }
    
    tab.Button = Instance.new("TextButton")
    tab.Button.Name = name .. "Tab"
    tab.Button.Size = UDim2.new(0, 120, 0, 40)
    tab.Button.BackgroundColor3 = self.Theme.Secondary
    tab.Button.BorderSizePixel = 0
    tab.Button.Font = DeviceDetection.IsMobile and Enum.Font.Gotham or Enum.Font.SourceSans
    tab.Button.Text = icon .. " " .. name
    tab.Button.TextColor3 = self.Theme.TextSecondary
    tab.Button.TextSize = Config.FontSize
    tab.Button.LayoutOrder = #self.Tabs
    tab.Button.Parent = self.TabContainer
    
    local tabCorner = Utility.CreateCorner(8)
    tabCorner.Parent = tab.Button
    
    tab.Frame = Instance.new("Frame")
    tab.Frame.Name = name .. "Content"
    tab.Frame.Size = UDim2.new(1, -20, 1, 0)
    tab.Frame.Position = UDim2.new(0, 10, 0, 0)
    tab.Frame.BackgroundTransparency = 1
    tab.Frame.BorderSizePixel = 0
    tab.Frame.Visible = false
    tab.Frame.Parent = self.ContentScroll
    
    tab.Layout = Instance.new("UIListLayout")
    tab.Layout.SortOrder = Enum.SortOrder.LayoutOrder
    tab.Layout.Padding = UDim.new(0, 10)
    tab.Layout.Parent = tab.Frame
    
    local function selectTab()
        self:SwitchTab(tab)
    end
    
    tab.Button.MouseButton1Click:Connect(selectTab)
    
    -- Mobile Touch Support
    if not DeviceDetection.IsPC then
        tab.Button.TouchTap:Connect(selectTab)
    end
    
    -- Hover Effects (PC Only)
    if DeviceDetection.IsPC then
        tab.Button.MouseEnter:Connect(function()
            if tab ~= self.CurrentTab then
                Utility.Tween(tab.Button, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Hover}):Play()
            end
        end)
        
        tab.Button.MouseLeave:Connect(function()
            if tab ~= self.CurrentTab then
                Utility.Tween(tab.Button, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Secondary}):Play()
            end
        end)
    end
    
    table.insert(self.Tabs, tab)
    
    -- Auto-select first tab
    if #self.Tabs == 1 then
        self:SwitchTab(tab)
    end
    
    return tab
end

function Window:SwitchTab(tab)
    if self.CurrentTab then
        -- Hide current tab
        self.CurrentTab.Frame.Visible = false
        self.CurrentTab.Button.BackgroundColor3 = self.Theme.Secondary
        self.CurrentTab.Button.TextColor3 = self.Theme.TextSecondary
    end
    
    -- Show new tab
    tab.Frame.Visible = true
    tab.Button.BackgroundColor3 = self.Theme.Accent
    tab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    self.CurrentTab = tab
    
    -- Update scroll size
    self.ContentScroll.CanvasSize = UDim2.new(0, 0, 0, tab.Frame.UIListLayout.AbsoluteContentSize.Y + 20)
end

