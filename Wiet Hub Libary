function Window:AnimateIn()
    self.MainFrame.Size = UDim2.new(0, 0, 0, 0)
    self.MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    Utility.Tween(self.MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = self.Size
    }):Play()
end

function Window:AnimateOut()
    Utility.Tween(self.MainFrame, TweenInfo.new(0.3), {
        Size = UDim2.new(0, 0, 0, 0)
    }):Play()
    
    task.wait(0.3)
    self:Destroy()
end

function Window:ToggleMinimize()
    self.IsMinimized = not self.IsMinimized
    
    if self.IsMinimized then
        -- Minimize
        self.ContentArea.Visible = false
        self.TabContainer.Visible = false
        Utility.Tween(self.MainFrame, TweenInfo.new(0.3), {Size = UDim2.new(self.Size.X.Scale, self.Size.X.Offset, 0, 50)}):Play()
        if self.MinimizeButton then
            self.MinimizeButton.Text = "□"
        end
    else
            self.ContentArea.Visible = true
        self.TabContainer.Visible = true
        Utility.Tween(self.MainFrame, TweenInfo.new(0.3), {Size = self.Size}):Play()
        if self.MinimizeButton then
            self.MinimizeButton.Text = "−"
        end
    end
end

function Window:Show()
    self.IsVisible = true
    self.ScreenGui.Enabled = true
end

function Window:Hide()
    self.IsVisible = false
    self.ScreenGui.Enabled = false
end

function Window:SetTheme(themeName)
    local theme = Themes[themeName]
    if theme then
        self.Theme = theme
        self:UpdateTheme()
    end
end

function Window:UpdateTheme()
    self.MainFrame.BackgroundColor3 = self.Theme.Primary
    self.TitleBar.BackgroundColor3 = self.Theme.Secondary
    self.TitleLabel.TextColor3 = self.Theme.Text
    self.ContentArea.BackgroundColor3 = self.Theme.Primary
    
    for _, tab in ipairs(self.Tabs) do
        if tab.Button then
            if tab == self.CurrentTab then
                tab.Button.BackgroundColor3 = self.Theme.Accent
                tab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                tab.Button.BackgroundColor3 = self.Theme.Secondary
                tab.Button.TextColor3 = self.Theme.TextSecondary
            end
        end
    end
end

function Window:Destroy()
    for _, connection in pairs(self.Connections) do
        if connection then
            connection:Disconnect()
        end
    end
    
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

