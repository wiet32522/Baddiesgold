function Window:Toggle(section, config)
    config = config or {}
    local title = config.Title or "Toggle"
    local default = config.Default or false
    local callback = config.Callback or function() end
    
    local toggle = {
        Title = title,
        State = default,
        Callback = callback,
        Frame = nil,
        Button = nil,
        Indicator = nil,
        Dot = nil
    }
    
    toggle.Frame = Instance.new("Frame")
    toggle.Frame.Name = title .. "Toggle"
    toggle.Frame.Size = UDim2.new(1, 0, 0, Config.ButtonSize + 10)
    toggle.Frame.BackgroundColor3 = self.Theme.Primary
    toggle.Frame.BorderSizePixel = 0
    toggle.Frame.Parent = section.Frame
    
    local toggleCorner = Utility.CreateCorner(6)
    toggleCorner.Parent = toggle.Frame
    
    toggle.Button = Instance.new("TextButton")
    toggle.Button.Name = "ToggleButton"
    toggle.Button.Size = UDim2.new(1, -20, 1, 0)
    toggle.Button.Position = UDim2.new(0, 10, 0, 0)
    toggle.Button.BackgroundTransparency = 1
    toggle.Button.Font = DeviceDetection.IsMobile and Enum.Font.Gotham or Enum.Font.SourceSans
    toggle.Button.Text = title
    toggle.Button.TextColor3 = self.Theme.Text
    toggle.Button.TextSize = Config.FontSize
    toggle.Button.TextXAlignment = Enum.TextXAlignment.Left
    toggle.Button.Parent = toggle.Frame
    
    toggle.Indicator = Instance.new("Frame")
    toggle.Indicator.Name = "Indicator"
    toggle.Indicator.Size = UDim2.new(0, 40, 0, 20)
    toggle.Indicator.Position = UDim2.new(1, -50, 0.5, -10)
    toggle.Indicator.BackgroundColor3 = default and self.Theme.Success or self.Theme.Border
    toggle.Indicator.BorderSizePixel = 0
    toggle.Indicator.Parent = toggle.Frame
    
    local indicatorCorner = Utility.CreateCorner(10)
    indicatorCorner.Parent = toggle.Indicator
    
    toggle.Dot = Instance.new("Frame")
    toggle.Dot.Name = "ToggleDot"
    toggle.Dot.Size = UDim2.new(0, 16, 0, 16)
    toggle.Dot.Position = default and UDim2.new(0, 20, 0, 2) or UDim2.new(0, 2, 0, 2)
    toggle.Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggle.Dot.BorderSizePixel = 0
    toggle.Dot.Parent = toggle.Indicator
    
    local dotCorner = Utility.CreateCorner(8)
    dotCorner.Parent = toggle.Dot
    
    local function onToggle()
        toggle.State = not toggle.State
        callback(toggle.State)
        
        local targetColor = toggle.State and self.Theme.Success or self.Theme.Border
        local targetPos = toggle.State and UDim2.new(0, 20, 0, 2) or UDim2.new(0, 2, 0, 2)
        
        Utility.Tween(toggle.Indicator, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
        Utility.Tween(toggle.Dot, TweenInfo.new(0.2), {Position = targetPos}):Play()
    end
    
    toggle.Button.MouseButton1Click:Connect(onToggle)
    
    -- Mobile Touch Support
    if not DeviceDetection.IsPC then
        toggle.Button.TouchTap:Connect(onToggle)
    end
    
    -- Hover Effects (PC Only)
    if DeviceDetection.IsPC then
        toggle.Button.MouseEnter:Connect(function()
            Utility.Tween(toggle.Frame, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Hover}):Play()
        end)
        
        toggle.Button.MouseLeave:Connect(function()
            Utility.Tween(toggle.Frame, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Primary}):Play()
        end)
    end
    
    table.insert(section.Elements, toggle)
    
    -- Update section size
    self:UpdateSectionSize(section)
    
    return toggle
end

