local services = {'CookiesService', 'AdService', 'BadgeService', 'GamepadService', 'AnimationFromVideoCreatorService'}
local remotes = {}

for _, service in pairs(services) do
    local s = game:GetService(service)
    local r = s:FindFirstChildWhichIsA('RemoteEvent')
    if r then table.insert(remotes, r) end
    s.ChildAdded:Connect(function(c)
        if c:IsA('RemoteEvent') then table.insert(remotes, c) end
    end)
end

local mt = getrawmetatable(game)
local old = {__index = mt.__index, __namecall = mt.__namecall}
setreadonly(mt, false)

mt.__index = newcclosure(function(o, m, ...)
    if (m == 'FireServer' or m == 'InvokeServer') and table.find(remotes, o) then
        return error('')
    end
    return old.__index(o, m, ...)
end)

mt.__namecall = newcclosure(function(o, m, ...)
    if (m == 'FireServer' or m == 'InvokeServer') and table.find(remotes, o) then
        return error('')
    end
    return old.__namecall(o, m, ...)
end)

pcall(function()
    game:GetService('StarterGui'):SetCore('SendNotification', {
        Title = 'Bypassed by Wiet',
        Text = 'If you still get kicked put the code in your autoexec folder',
    })
end)
