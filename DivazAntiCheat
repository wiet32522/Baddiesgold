local originalKick = hookfunction(game.Players.LocalPlayer.Kick, newcclosure(function() return end))

for _, v in getgc(true) do
    if type(v) == "function" then
        local fnInfo = getinfo(v)
        if fnInfo.name == "Detected" or (fnInfo.linedefined == 45 and fnInfo.numparams == 1) then
            hookfunction(v, newcclosure(function() return end))
            break
        end
    end
end

local oldTaskDelay = hookfunction(task.delay, newcclosure(function(time, callback)
    if time == 2 then
        local trace = debug.traceback(callback)
        if trace:find("Part") and trace:find("while true do") then
            return nil
        end
    end
    return oldTaskDelay(time, callback)
end))
